cc_binary {
    name: "socat",
    srcs: [
        "socat/socat.c",
        "socat/dalan.c",
        "socat/error.c",
        "socat/fdname.c",
        "socat/hostan.c",
        "socat/filan.c",
        "socat/nestlex.c",
        "socat/procan.c",
        "socat/snprinterr.c",
        "socat/sslcls.c",
        "socat/sycls.c",
        "socat/sysutils.c",
        "socat/utils.c",
        "socat/vsnprintf_r.c",
        "socat/xio-ascii.c",
        "socat/xio-creat.c",
        "socat/xio-dccp.c",
        "socat/xio-exec.c",
        "socat/xio-fd.c",
        "socat/xio-fdnum.c",
        "socat/xio-file.c",
        "socat/xio-fs.c",
        "socat/xio-gopen.c",
        "socat/xio-interface.c",
        "socat/xio-ip.c",
        "socat/xio-ip4.c",
        "socat/xio-ip6.c",
        "socat/xio-ipapp.c",
        "socat/xio-listen.c",
        "socat/xio-named.c",
        "socat/xio-namespaces.c",
        "socat/xio-openssl.c",
        "socat/xio-pipe.c",
        "socat/xio-posixmq.c",
        "socat/xio-process.c",
        "socat/xio-progcall.c",
        "socat/xio-proxy.c",
        "socat/xio-pty.c",
        "socat/xio-rawip.c",
        "socat/xio-readline.c",
        "socat/xio-sctp.c",
        "socat/xio-shell.c",
        "socat/xio-socket.c",
        "socat/xio-socketpair.c",
        "socat/xio-socks.c",
        "socat/xio-socks5.c",
        "socat/xio-stdio.c",
        "socat/xio-streams.c",
        "socat/xio-system.c",
        "socat/xio-tcp.c",
        "socat/xio-tcpwrap.c",
        "socat/xio-termios.c",
        "socat/xio-tun.c",
        "socat/xio-udp.c",
        "socat/xio-udplite.c",
        "socat/xio-unix.c",
        "socat/xio-vsock.c",
        "socat/xioclose.c",
        "socat/xiodiag.c",
        "socat/xioexit.c",
        "socat/xiohelp.c",
        "socat/xioinitialize.c",
        "socat/xiolayer.c",
        "socat/xiolockfile.c",
        "socat/xioopen.c",
        "socat/xioopts.c",
        "socat/xioparam.c",
        "socat/xioread.c",
        "socat/xioshutdown.c",
        "socat/xiosigchld.c",
        "socat/xiosignal.c",
        "socat/xiowrite.c",
        "socat/xio-rpmsgsocket.c",
        ],
    cflags: [
        "-Wno-date-time",
        "-Wno-undef",
        "-Wno-shadow",
        "-Wno-format",
        "-Wno-unused-variable",
        "-Wno-parentheses",
        "-Wno-implicit-function-declaration",
        "-Wno-incompatible-pointer-types",
        "-Wno-pointer-sign",
        "-Wno-unknown-directives",
        "-Wno-unused-function",
    ],

    header_libs: ["apps_netutils_headers", "nuttx_libc_headers"],
    shared_libs: ["libcutils"],
    proprietary: true,
}
