choice
	prompt "select Zephyr repository"
	default ZEPHYR_REPO_DEFAULT
	config ZEPHYR_REPO_3_0_1
		bool "use Zephyr 3.0.1 repository"
	config ZEPHYR_REPO_DEFAULT
		bool "use default(openvela) Zephyr repository"
endchoice

if ZEPHYR_REPO_DEFAULT
osource "$APPSDIR/external/zblue/Kconfig.default"
endif #ZEPHYR_REPO_DEFAULT

if ZEPHYR_REPO_3_0_1
osource "$APPSDIR/external/zblue/Kconfig.3_0_1"
endif #ZEPHYR_REPO_3_0_1

